# Copie este arquivo para .env e troque os valores.
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
# Caminho do banco, relativo à pasta backend
CAMINHO_BANCO=validador.db

# --- Integração com a Nuvemshop (Etapa 7). Vazio = integração desligada. ---
# Segredo do app (client secret), usado para conferir a assinatura do webhook.
NUVEMSHOP_SEGREDO_APP=
# Token de acesso da loja, usado para buscar o pedido na API.
NUVEMSHOP_TOKEN_ACESSO=
# E-mail da conta do Validador de Vendas que é dona da loja.
NUVEMSHOP_EMAIL_USUARIO=

# --- Integração com a Shopify (preparada no mesmo formato). ---
# Segredo mostrado em Configurações > Notificações > Webhooks.
SHOPIFY_SEGREDO_WEBHOOK=
SHOPIFY_EMAIL_USUARIO=
